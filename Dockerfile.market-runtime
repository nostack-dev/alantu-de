FROM node:22-bookworm-slim

WORKDIR /app

ENV PORT="8080"
ENV ALLOWED_ORIGINS="https://www.alantu.de,https://alantu.de"

COPY market-relay/package.json ./market-relay/package.json
RUN cd market-relay && npm install --omit=dev

COPY market-relay/server.mjs ./market-relay/server.mjs
COPY market-runtime/supervisor.mjs ./market-runtime/supervisor.mjs
COPY market-runtime/trainer-loop.mjs ./market-runtime/trainer-loop.mjs
COPY tools/microstructure-core.mjs ./tools/microstructure-core.mjs
COPY tools/microstructure-signal.mjs ./tools/microstructure-signal.mjs
COPY tools/raw-sip-wave-core.mjs ./tools/raw-sip-wave-core.mjs
COPY tools/train-raw-sip-wave.mjs ./tools/train-raw-sip-wave.mjs
COPY microstructure-edge-status.json ./microstructure-edge-status.json
COPY orcl-raw-sip-model.json ./orcl-raw-sip-model.json

EXPOSE 8080

CMD ["node","market-runtime/supervisor.mjs"]
