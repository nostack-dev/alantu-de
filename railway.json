{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.market-runtime",
    "watchPatterns": [
      "Dockerfile.market-runtime",
      "railway.json",
      "market-runtime/**",
      "market-relay/**",
      "tools/microstructure-core.mjs",
      "tools/raw-sip-wave-core.mjs",
      "tools/train-raw-sip-wave.mjs",
      "orcl-raw-sip-model.json"
    ]
  },
  "deploy": {
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
