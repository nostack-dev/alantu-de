# Required once Alpaca verification is complete.
# Add only these two secrets in Railway -> alantu-market -> Variables.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# Production market-data contract.
ALANTU_MARKET_FEED=sip
MICRO_SYMBOL=ORCL
MICRO_SYMBOLS=ORCL
ALLOWED_ORIGINS=https://www.alantu.de,https://alantu.de

# Persistent raw-SIP feature/model cache.
RAW_SIP_DATA_DIR=/data/alantu
RAW_EDGE_CALENDAR_DAYS=365
RAW_EDGE_MIN_USABLE_DAYS=200
RAW_EDGE_TRAIN_INTERVAL_HOURS=12
RAW_EDGE_SLIPPAGE_BPS=0.35
RAW_EDGE_RIDGE_LAMBDA=12

# Databento is retired from the production signal path.
